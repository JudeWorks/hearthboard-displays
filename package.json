{
  "name": "hearthboard-displays",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "node scripts/validate.mjs",
    "test": "node --test scripts/*.test.mjs",
    "deploy": "npm run check && npm run build && wrangler pages deploy dist --project-name hearthboard-displays --branch main",
    "prepare:release": "node scripts/prepare-release.mjs",
    "check:links": "python3 scripts/check-links.py"
  },
  "dependencies": {
    "astro": "7.4.1",
    "esp-web-tools": "10.4.0"
  },
  "devDependencies": {
    "wrangler": "4.151.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
