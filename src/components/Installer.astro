---
import { releases } from '../data/releases';
import Icon from './Icon.astro';
const release = releases.ink;
---
<div class="install-panel" id="installer">
  <h2>Install firmware over USB</h2>
  <p>Connect your board to a computer with a USB data cable. Use desktop Chrome or Edge.</p>
  <label class="form-label" for="board">Board</label>
  <select id="board" name="board"><option value="ee04">TRMNL 7.5″ DIY kit · Seeed EE04 / ESP32-S3 Plus</option><option value="e1001" disabled>reTerminal E1001 — not available yet</option><option value="e1002" disabled>reTerminal E1002 — not available yet</option></select>
  {release ? <>
    <div class="notice warning"><strong>Replaces the current firmware</strong><p>A fresh installation can erase Wi-Fi, pairings, widgets, and service settings. Check the exact board and keep the manufacturer's recovery instructions available.</p></div>
    <label class="checkbox-label"><input id="install-consent" type="checkbox"/><span>This is a Seeed EE04 DIY kit, and I understand that installation can reset its saved settings.</span></label>
    <div id="install-control" hidden><esp-web-install-button manifest={release.manifestPath}><button slot="activate" class="button primary"><Icon name="usb" size={17}/>Install Hearthboard Ink</button><span slot="unsupported" class="small">Use desktop Chrome or Edge to install over USB.</span><span slot="not-allowed" class="small">A secure HTTPS connection is needed.</span></esp-web-install-button></div>
    <button id="install-locked" class="button primary" disabled><Icon name="usb" size={17}/>Confirm your board above</button>
    <p id="browser-support" class="release-state" role="status" aria-live="polite"></p><p class="download-meta">{release.version} · {release.channel} · <a href="/releases/">Release notes & checksum</a></p>
  </> : <div class="notice"><strong>Coming soon</strong><p>Hearthboard Ink is on its way. The browser installer will be available here when it's ready.</p></div>}
  <p class="small">After flashing, follow the display's instructions to connect Wi-Fi and pair your iPhone.</p>
</div>
<script>
  const consent = document.querySelector<HTMLInputElement>('#install-consent');
  if (consent) {
    const control = document.querySelector<HTMLElement>('#install-control');
    const locked = document.querySelector<HTMLElement>('#install-locked');
    const status = document.querySelector<HTMLElement>('#browser-support');
    const supported = 'serial' in navigator && window.isSecureContext;
    if (status) status.textContent = supported ? 'USB flashing runs directly between this browser and your board.' : 'Use desktop Chrome or Edge over HTTPS to flash your board.';
    consent.addEventListener('change', async () => {
      if (control) control.hidden = !consent.checked || !supported;
      if (locked) locked.hidden = consent.checked && supported;
      if (consent.checked && supported && !customElements.get('esp-web-install-button')) {
        try { await import('esp-web-tools/dist/web/install-button.js'); }
        catch { if (status) status.textContent = 'The installer could not load. Check your connection and refresh the page.'; }
      }
    });
  }
</script>
