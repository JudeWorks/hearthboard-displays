---
import Base from '../../layouts/Base.astro';
import { guides } from '../../data/guides';
import { support } from '../../data/site';
---
<Base title="Setup guides · Hearthboard Displays">
<div class="container docs-index"><h1>Setup guides</h1><p>Installation, pairing, and troubleshooting.</p>
{(['ink','frame','shared'] as const).map(category=><section class="guide-group"><h2>{category === 'ink' ? 'Hearthboard Ink' : category === 'frame' ? 'Hearthboard Frame' : 'Both displays'}</h2><ul class="guide-list">{guides.filter(g=>g.category === category).map(guide=><li><a href={`/docs/${guide.slug}/`}><strong>{guide.title}</strong><span>{guide.description}</span></a></li>)}</ul></section>)}
<p class="setup-help">Still stuck? <a href={support}>Report an issue on GitHub</a>. Remove private details before posting.</p></div>
</Base>
