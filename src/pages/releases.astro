---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { releases, formatBytes } from '../data/releases';
import { repository } from '../data/site';
---
<Base title="Downloads & releases · Hearthboard Displays" description="Public release availability for Hearthboard Ink firmware and Hearthboard Frame Android APKs. Version details, checksums, release notes, and recovery guidance.">
<section class="container page-title"><div class="breadcrumb"><a href="/">Displays</a><span>/</span><span>Downloads</span></div><div class="eyebrow">A FRESH START, OR THE NEXT CHAPTER</div><h1>Downloads & releases.</h1><p>Choose your display, check the release notes, and keep a little help close by.</p></section>
<section class="container release-grid">{(['ink','frame'] as const).map(product => { const release = releases[product]; return <article class="release-card"><span class="pill">{product === 'ink' ? 'ESP32 e-paper' : 'Android photo frames'}</span><h2>Hearthboard {product === 'ink' ? 'Ink' : 'Frame'}</h2>{release ? <><p class="status-line">{release.version} · {release.channel} · {release.date}</p><p>{release.notes}</p><a class="button primary" href={product === 'ink' ? '/ink/#installer' : release.downloadURL}>{product === 'ink' ? 'Open browser installer' : 'Download signed APK'} <Icon name="download" size={18}/></a><p class="download-meta">{formatBytes(release.size)}{product === 'frame' ? ` · Android API ${release.minSdk}+ · Version code ${release.versionCode}` : ` · ${release.board}`}</p><p class="download-meta">SHA-256: <code>{release.sha256}</code></p></> : <><p class="empty-release">First public {product === 'ink' ? 'firmware release' : 'beta'} coming soon.</p><p>{product === 'ink' ? 'The initial target is the Seeed EE04 / TRMNL 7.5″ DIY kit. The installer opens when its verified firmware is published.' : 'The signed Android APK will be available after release verification. Check your frame’s compatibility in the meantime.'}</p><a class="button outline" href={product === 'ink' ? '/docs/ink-setup/' : '/docs/frame-compatibility/'}>{product === 'ink' ? 'Read the Ink guide' : 'Check frame compatibility'} <Icon name="arrow" size={18}/></a></>}<div style="margin-top:25px"><a class="privacy-link" href={product === 'ink' ? '/docs/ink-recovery/' : '/docs/updates/'}>{product === 'ink' ? 'Recovery & stock firmware' : 'Installing over an existing build'}</a></div></article>;})}</section>
<section class="content-section"><div class="container two-col"><div><h2>Know what you're installing.</h2><p class="prose">Each release belongs to a particular product and hardware target. An ESP32-S3 image isn't interchangeable across all boards, and an Android APK needs a compatible frame and signing identity.</p><a class="text-link" href="/docs/updates/">Read the update guide <Icon name="arrow" size={18}/></a></div><div><h2>Keep the history handy.</h2><p class="prose">Published binary assets and their notes live in the public GitHub repository. The private app and firmware source are kept separate.</p><a class="button outline" href={`${repository}/releases`}>GitHub Releases <Icon name="arrow" size={18}/></a><div class="notice">Release archives for this public repository contain the website and documentation. They do not contain the private Android or firmware source.</div></div></div></section>
</Base>
