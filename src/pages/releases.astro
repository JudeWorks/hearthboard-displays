---
import Base from '../layouts/Base.astro';
import { releases, formatBytes } from '../data/releases';
import { repository, appStoreURL } from '../data/site';
---
<Base title="Releases · Hearthboard Displays"><section class="container docs-index"><h1>Releases</h1><p>Verified public firmware and Android APKs.</p>{(['ink','frame'] as const).map(product=>{const release=releases[product];return <section class="release-card"><h2>Hearthboard {product === 'ink' ? 'Ink' : 'Frame'}</h2>{release ? <><p>{release.version} · {release.channel} · {release.date}</p><p>{release.notes}</p><a class="button primary" href={product === 'ink' ? '/ink/#installer' : release.downloadURL}>{product === 'ink' ? 'Open USB installer' : 'Download APK'}</a><p class="download-meta">{formatBytes(release.size)} · {product === 'ink' ? release.board : `Android API ${release.minSdk}+ · Version code ${release.versionCode}`}</p><p class="download-meta">SHA-256: <code>{release.sha256}</code></p></> : <p><strong>Coming soon.</strong> {product === 'ink' ? 'Firmware and the browser installer' : 'The Android app'} will be available here when ready.</p>}<a href={product === 'ink' ? '/docs/ink-setup/' : '/docs/frame-install/'}>Setup guide →</a></section>;})}<p class="ipad-app-link">Hearthboard for iPad is available now.<br /><a href={appStoreURL}>View on the App Store <span aria-hidden="true">↗</span></a></p><p class="setup-help"><a href={`${repository}/releases`}>GitHub release history</a><span> · </span><a href="/docs/updates/">Updating & recovery</a></p></section></Base>
